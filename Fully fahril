local function MakeStatCard(posY, icon, text, accentColor)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, -24, 0, 24)
    card.Position = UDim2.new(0, 12, 0, posY)
    card.BackgroundColor3 = COLOR.BgCard
    card.BackgroundTransparency = 0.15
    card.BorderSizePixel = 0
    card.ZIndex = 3
    card.Parent = StatsSection
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)
    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0, 3, 0, 14)
    accent.Position = UDim2.new(0, 0, 0.5, -7)
    accent.BackgroundColor3 = accentColor
    accent.BorderSizePixel = 0
    accent.ZIndex = 4
    accent.Parent = card
    Instance.new("UICorner", accent).CornerRadius = UDim.new(1, 0)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -14, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = icon .. " " .. text
    label.Font = Enum.Font.Gotham
    label.TextSize = 10
    label.TextColor3 = COLOR.GrayLight
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 4
    label.Parent = card
    return label
end

